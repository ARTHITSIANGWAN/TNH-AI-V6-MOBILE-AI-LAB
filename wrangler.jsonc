{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thitnueahub-core-db", 
  "main": "main.go", // ใน Repo นี้ไฟล์หลักชื่อ main.go (ไม่ใช่ cmd/main.go) ต้องระบุให้ถูก!
  "compatibility_date": "2026-03-28",
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3d180da092ea4cfeb70c027d7ab11098"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thitnueahub-core-db",
      "database_id": "6a8b4373-bf40-4b63-bb02-f612ecbe63b7"
    }
  ]
}

